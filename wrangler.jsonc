{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "delvin-socks",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Remote database id is filled in after `wrangler d1 create` (see README).
      // Local dev/preview uses a local emulation automatically.
      "database_name": "delvin-socks-db",
      "database_id": "local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "delvin-socks-uploads"
    }
  ]
}
